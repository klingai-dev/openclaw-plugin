{
  "name": "kling-ai-global-openclaw",
  "version": "1.1.27",
  "type": "module",
  "description": "Generate and edit images, create image series, and make videos with Kling 4.0 and Kling 4.0 Flash in OpenClaw through the official Kling AI MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klingai-dev/openclaw-plugin.git"
  },
  "scripts": {
    "check": "python3 scripts/check.py",
    "test": "python3 scripts/check.py && python3 -m unittest discover -s scripts -p \"test_*.py\"",
    "pack:release": "python3 scripts/package-release.py",
    "login": "python3 scripts/login.py"
  },
  "files": [
    "index.mjs",
    "openclaw.plugin.json",
    "skills/",
    "README.md",
    "LICENSE",
    "docs/",
    "scripts/check.py",
    "scripts/login.py",
    "scripts/package-release.py",
    "scripts/test_login.py",
    "scripts/test_package.py"
  ],
  "openclaw": {
    "extensions": ["./index.mjs"],
    "install": {
      "clawhubSpec": "kling-ai-global-openclaw",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.9.4"
    },
    "compat": {
      "pluginApi": ">=2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
