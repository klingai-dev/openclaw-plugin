{
  "id": "kling-ai",
  "name": "Kling AI",
  "description": "Generate images and videos with Kling AI through the official remote MCP service.",
  "version": "1.1.17",
  "categories": ["media"],
  "activation": {
    "onStartup": true
  },
  "skills": ["skills"],
  "mcpServers": {
    "kling-ai": {
      "url": "https://klingai.com/mcp/plugin",
      "transport": "streamable-http",
      "auth": "oauth",
      "headers": {
        "X-Kling-Integration": "Plugin-OpenClaw"
      },
      "supportsParallelToolCalls": false,
      "connectionTimeoutMs": 30000,
      "requestTimeoutMs": 60000
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}
